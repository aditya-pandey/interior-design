{
  "name": "gh18-viewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.play.config.js",
    "dev:play": "vite -c vite.play.config.js --open /play/",
    "play:shots": "node scripts/play_shots.mjs",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "film": "node film/render.mjs gpu && python3 film/post.py ../renders/film/GH-18_film.mp4",
    "birthday": "node scripts/birthday/render.mjs",
    "drive:test": "node scripts/drive_harness.mjs --compare"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "three": "0.170.0"
  },
  "devDependencies": {
    "playwright": "1.48.2",
    "vite": "5.4.11"
  }
}
